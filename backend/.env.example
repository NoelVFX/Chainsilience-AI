# ---- ChainSight AI backend configuration -------------------------------------
# Copy to .env and adjust. All values have sensible defaults; the app runs with
# none of these set.

# App
ENVIRONMENT=development
DEBUG=true

# Security — CHANGE THIS in any non-local environment.
SECRET_KEY=dev-insecure-change-me-in-production-00000000000000000000
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database. SQLite by default (zero-config). For Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg://chainsight:chainsight@localhost:5432/chainsight
DATABASE_URL=sqlite:///./chainsight.db
SEED_ON_STARTUP=true

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI — OPTIONAL. Without a key the app uses deterministic offline fallbacks for
# every AI module (verifier, relevance, extraction, reasoning, recommendations, emails).
#
# Provider auto-selection: NVIDIA (Nemotron) > OpenAI > offline fallback.
#
# NVIDIA Nemotron (OpenAI-compatible endpoint). Set the key to activate the live
# AI agents. NVIDIA_MODEL takes the exact model id from build.nvidia.com.
# NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# OpenAI (used only if NVIDIA_API_KEY is unset).
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Email / sign-up OTP — OPTIONAL. Verification codes for new accounts are sent
# here. Without SMTP configured the code is logged server-side and (when
# ENVIRONMENT != production) returned in the API response so the flow stays
# testable with zero email infrastructure. Set these three to send real email
# (e.g. a Gmail App Password, SendGrid, Mailgun, or Postmark):
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com          # defaults to SMTP_USER
# SMTP_PORT=587                     # 587 = STARTTLS, 465 = SSL
# SMTP_USE_TLS=true                 # true = STARTTLS on 587; false = SSL on 465
# OTP_TTL_SECONDS=600               # code lifetime (default 10 min)
# OTP_MAX_ATTEMPTS=5                # wrong tries before a new code is required
# Base URL used to build the password-reset link in emails. Set to the real
# frontend domain in production (defaults to the local dev server).
FRONTEND_BASE_URL=http://localhost:3000
# RESET_TOKEN_TTL_SECONDS=1800      # reset-link lifetime (default 30 min)

# Billing / Stripe — OPTIONAL. Gate the platform behind a paid plan via Stripe
# Checkout. WITHOUT STRIPE_SECRET_KEY the gate is INACTIVE (the app runs open,
# exactly as before) and checkout links can't be created. The demo account
# (DEMO_EMAIL) is always exempt so the public demo stays free.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...     # from the webhook endpoint /api/v1/billing/webhook
# REQUIRE_PAYMENT=1                    # set 0 to disable the gate even when a key is set
# STRIPE_GROWTH_PRICE_CENTS=49900      # Growth plan price in cents ($499/mo)
# STRIPE_CURRENCY=usd

# News scraping (RSS). Comma/JSON list overrides the built-in supply-chain feeds.
# NEWS_RSS_FEEDS=["https://gcaptain.com/feed/","https://www.freightwaves.com/feed"]
